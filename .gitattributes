# Shell scripts must check out with LF on every platform — bash fails on CRLF
# (shebang + `set -euo pipefail` both break with trailing \r).
*.sh text eol=lf
plugins/booking-bandit/references/*.md text eol=lf
plugins/shortform-superengine/skills/*/references/legit-*.md text eol=lf
# editor-superengine ships sha256-pinned files (vendored scenes, locks); keep its text LF on every
# checkout so a Windows clone (core.autocrlf=true) gets the bytes that were vetted.
plugins/editor-superengine/** text=auto eol=lf
