# Installed by bin/install.sh, which replaces @CODE_ROOT@, @ROOT@, @CONF@ and @NODE@.
[Unit]
Description=fewzhun-box sync: pull the notes repo, copy active notes into spokes, reindex changed spokes
After=network-online.target
Wants=network-online.target
OnFailure=fewzhun-box-alert@sync.service

[Service]
Type=oneshot
User=fbx
Group=fbx
UMask=0007
Environment=HOME=/var/lib/fewzhun-box
Environment=FEWZHUN_BOX_CONFIG=@CONF@
ExecStart=@NODE@ @CODE_ROOT@/app/bin/fewzhun-box.mjs sync
TimeoutStartSec=30min
Nice=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# vault/ is the git clone, spokes/ the active copies + indexes; HOME keeps ssh known_hosts and the model.
ReadWritePaths=@ROOT@/vault @ROOT@/spokes /var/lib/fewzhun-box
