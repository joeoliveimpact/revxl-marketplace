{
  "$schema": "https://workspace-superengine.dev/schemas/module.v1.json",
  "name": "client-work",
  "version": "1.0.0",
  "description": "Adds a clients/ folder with a per-client template (intake, sessions, deliverables) and a confidentiality + boundary rule.",
  "requires": { "scaffold": ">=0.2.0" },
  "creates": [
    { "type": "directory", "path": "clients", "gitkeep": false },
    { "type": "file", "path": "clients/_template/README.md", "source": "files/_template/README.md", "overwrite": "ask" },
    { "type": "file", "path": "clients/_template/intake.md", "source": "files/_template/intake.md", "overwrite": "ask" },
    { "type": "file", "path": "clients/_template/sessions.md", "source": "files/_template/sessions.md", "overwrite": "ask" },
    { "type": "file", "path": "clients/_template/deliverables.md", "source": "files/_template/deliverables.md", "overwrite": "ask" },
    { "type": "file", "path": ".claude/rules/client-work.md", "source": "files/client-work.md", "overwrite": "ask" }
  ],
  "postInstallMessage": "Client-work module installed. Copy clients/_template/ to clients/<client-name>/ for each new client. client-work.md enforces confidentiality + boundary rules across the workspace."
}
